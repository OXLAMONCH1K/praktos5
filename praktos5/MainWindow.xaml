<Window x:Class="praktos4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Треугольник" Height="390" Width="400">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0"
               Content="Сторона A:"/>
        <TextBox x:Name="txtA"
                 Grid.Row="0" Grid.Column="1"
                 Margin="5"
                 Text="3"/>
        <Label Grid.Row="1" Grid.Column="0"
               Content="Сторона B:"/>
        <TextBox x:Name="txtB"
                 Grid.Row="1" Grid.Column="1"
                 Margin="5"
                 Text="4"/>
        <Label Grid.Row="2" Grid.Column="0"
               Content="Сторона C:"/>
        <TextBox x:Name="txtC"
                 Grid.Row="2" Grid.Column="1"
                 Margin="5"
                 Text="5"/>
        <Button x:Name="btnSet"
                Grid.Row="3" Grid.Column="0"
                Grid.ColumnSpan="2"
                Content="Проверить стороны"
                Margin="5"
                Click="btnSet_Click"/>
        <Button x:Name="btnDouble"
                Grid.Row="4" Grid.Column="1"
                Content="Увеличить стороны на 1"
                Margin="78,5,5,5"
                Click="btnDouble_Click"/>
        <Button x:Name="btnDouble2"
    Grid.Row="4"
    Content="Уменьшить стороны на 1"
    Margin="10,5,203,5"
    Click="btnDouble_Click2" Grid.ColumnSpan="2"/>
        <TextBox x:Name="txtResult"
                 Grid.Row="5" Grid.Column="0"
                 Grid.ColumnSpan="2"
                 Margin="5"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="6" Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Content="О программе"
                    Width="120"
                    Margin="5"
                    Click="btnInfo_Click"/>

            <Button Content="Выход"
                    Width="120"
                    Margin="5"
                    Click="btnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>